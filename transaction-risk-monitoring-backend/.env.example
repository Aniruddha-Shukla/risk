# Backend environment variables. Java does not read this file automatically:
# set these in the Render dashboard, or `export` them in your shell for local runs.

# Option 1 - Neon connection string (Neon dashboard > Connect). Takes priority when set.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Option 2 - individual settings, used only when DATABASE_URL is unset (defaults shown)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=risk_monitoring
DB_USER=postgres
DB_PASSWORD=

# HTTP port (Render injects this automatically)
PORT=8080

# Comma-separated frontend origins allowed by CORS; leave unset to allow any origin
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:5173

# Risk engine tuning
RISK_FLAG_THRESHOLD=50
RISK_LARGE_AMOUNT=50000
RISK_AVG_MULTIPLIER=3
RISK_VELOCITY_LIMIT=3
